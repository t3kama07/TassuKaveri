[debug] [2026-03-13T20:49:53.870Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/tassukaveri-2012a/rulesets {"name":"projects/tassukaveri-2012a/rulesets/4f3c151f-2fa4-40e6-96e0-3c0990213fa2","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isSelf(userId) {\n      return signedIn() && request.auth.uid == userId;\n    }\n\n    function userDoc(userId) {\n      return get(/databases/$(database)/documents/users/$(userId));\n    }\n\n    function userDocExists(userId) {\n      return exists(/databases/$(database)/documents/users/$(userId));\n    }\n\n    function isAdmin() {\n      return signedIn()\n        && userDocExists(request.auth.uid)\n        && userDoc(request.auth.uid).data.role == 'admin';\n    }\n\n    function actorNotFrozen() {\n      return !signedIn()\n        || !userDocExists(request.auth.uid)\n        || userDoc(request.auth.uid).data.frozen != true;\n    }\n\n    function ownerOrAdmin(userId) {\n      return isSelf(userId) || isAdmin();\n    }\n\n    function publicProfileDataValid(userId) {\n      return request.resource.data.keys().hasOnly([\n        'uid',\n        'name',\n        'location',\n        'country',\n        'photoURL',\n        'bio',\n        'petExperience',\n        'availability',\n        'phoneVerified',\n        'petTypeExperience',\n        'preferredPetSize',\n        'experienceLevel',\n        'experienceWithDogs',\n        'experienceWithCats',\n        'experienceWithLargeDogs',\n        'experienceWithSeniorPets',\n        'latitude',\n        'longitude',\n        'ratingAverage',\n        'ratingCount',\n        'trustScore',\n        'hasDetailedAvailability',\n        'nextAvailableStartAt',\n        'nextAvailableEndAt',\n        'createdAt',\n        'updatedAt'\n      ])\n        && request.resource.data.uid == userId\n        && request.resource.data.name is string\n        && request.resource.data.location is string\n        && request.resource.data.country is string\n        && request.resource.data.photoURL is string\n        && request.resource.data.bio is string\n        && request.resource.data.petExperience is string\n        && request.resource.data.availability in ['available', 'unavailable']\n        && request.resource.data.phoneVerified is bool\n        && request.resource.data.petTypeExperience is list\n        && request.resource.data.preferredPetSize is list\n        && request.resource.data.experienceLevel in ['beginner', 'intermediate', 'expert']\n        && request.resource.data.experienceWithDogs is bool\n        && request.resource.data.experienceWithCats is bool\n        && request.resource.data.experienceWithLargeDogs is bool\n        && request.resource.data.experienceWithSeniorPets is bool\n        && (!('latitude' in request.resource.data)\n          || request.resource.data.latitude == null\n          || request.resource.data.latitude is number)\n        && (!('longitude' in request.resource.data)\n          || request.resource.data.longitude == null\n          || request.resource.data.longitude is number)\n        && request.resource.data.ratingAverage is number\n        && request.resource.data.ratingCount is number\n        && request.resource.data.trustScore is number\n        && (!('hasDetailedAvailability' in request.resource.data)\n          || request.resource.data.hasDetailedAvailability is bool)\n        && (!('nextAvailableStartAt' in request.resource.data)\n          || request.resource.data.nextAvailableStartAt == null\n          || request.resource.data.nextAvailableStartAt is timestamp)\n        && (!('nextAvailableEndAt' in request.resource.data)\n          || request.resource.data.nextAvailableEndAt == null\n          || request.resource.data.nextAvailableEndAt is timestamp)\n        && request.resource.data.createdAt is timestamp\n        && request.resource.data.updatedAt is timestamp;\n    }\n\n    function availabilitySlotDataValid() {\n      return request.resource.data.keys().hasOnly([\n        'startAt',\n        'endAt',\n        'createdAt',\n        'updatedAt'\n      ])\n        && request.resource.data.startAt is timestamp\n        && request.resource.data.endAt is timestamp\n        && request.resource.data.createdAt is timestamp\n        && request.resource.data.updatedAt is timestamp\n        && request.resource.data.endAt > request.resource.data.startAt\n        && request.resource.data.startAt > request.time;\n    }\n\n    function reviewSummaryUpdateAllowed(userId) {\n      let ownerId = request.auth.uid;\n      let requestId = request.resource.data.lastReviewRequestId;\n      let requestBefore = get(\n        /databases/$(database)/documents/users/$(ownerId)/requests/$(requestId)\n      );\n      let requestAfter = getAfter(\n        /databases/$(database)/documents/users/$(ownerId)/requests/$(requestId)\n      );\n      let previousCount = resource.data.ratingCount;\n      let previousAverage = resource.data.ratingAverage;\n      let nextCount = request.resource.data.ratingCount;\n      let reviewRating = requestAfter.data.review.rating;\n\n      return signedIn()\n        && actorNotFrozen()\n        && !isSelf(userId)\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'ratingCount',\n          'ratingAverage',\n          'updatedAt',\n          'lastReviewOwnerId',\n          'lastReviewRequestId'\n        ])\n        && request.resource.data.lastReviewOwnerId == ownerId\n        && requestId is string\n        && request.resource.data.updatedAt is timestamp\n        && nextCount is number\n        && request.resource.data.ratingAverage is number\n        && previousCount is number\n        && previousAverage is number\n        && requestBefore.data.sitterId == userId\n        && requestBefore.data.status == 'completed'\n        && (!('review' in requestBefore.data) || requestBefore.data.review == null)\n        && requestAfter.data.sitterId == userId\n        && requestAfter.data.status == 'completed'\n        && requestAfter.data.review.rating is number\n        && requestAfter.data.review.reviewerId == ownerId\n        && nextCount == previousCount + 1\n        && request.resource.data.ratingAverage\n          == ((previousAverage * previousCount) + reviewRating) / nextCount;\n    }\n\n    function publicReviewSummarySyncAllowed(userId) {\n      let privateProfileAfter = getAfter(/databases/$(database)/documents/users/$(userId));\n      return signedIn()\n        && actorNotFrozen()\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'ratingCount',\n          'ratingAverage',\n          'updatedAt'\n        ])\n        && request.resource.data.ratingCount == privateProfileAfter.data.ratingCount\n        && request.resource.data.ratingAverage == privateProfileAfter.data.ratingAverage\n        && request.resource.data.updatedAt is timestamp\n        && privateProfileAfter.data.lastReviewOwnerId == request.auth.uid;\n    }\n\n    match /publicProfiles/{userId} {\n      allow read: if signedIn();\n      allow create, update: if publicProfileDataValid(userId)\n        && (\n          (ownerOrAdmin(userId) && actorNotFrozen())\n          || publicReviewSummarySyncAllowed(userId)\n        );\n      allow delete: if isAdmin();\n    }\n\n    match /users/{userId} {\n      allow read: if ownerOrAdmin(userId);\n      allow create: if ownerOrAdmin(userId) && actorNotFrozen();\n      allow update: if (ownerOrAdmin(userId) && actorNotFrozen())\n        || reviewSummaryUpdateAllowed(userId);\n      allow delete: if isAdmin();\n\n      match /pets/{petId} {\n        allow read, create, update, delete: if ownerOrAdmin(userId) && actorNotFrozen();\n      }\n\n      match /availabilitySlots/{slotId} {\n        allow read: if ownerOrAdmin(userId);\n        allow create, update: if ownerOrAdmin(userId)\n          && actorNotFrozen()\n          && availabilitySlotDataValid();\n        allow delete: if ownerOrAdmin(userId) && actorNotFrozen();\n      }\n\n      match /wallet/{walletId} {\n        function walletDocPath() {\n          return /databases/$(database)/documents/users/$(userId)/wallet/$(walletId);\n        }\n\n        function escrowReleaseWalletUpdateAllowed() {\n          let action = request.resource.data.lastWalletAction;\n          let requestId = request.resource.data.lastRequestId;\n          let ownerId = request.resource.data.lastRequestOwnerId;\n          let requestDoc = getAfter(/databases/$(database)/documents/users/$(ownerId)/requests/$(requestId)).data;\n          return signedIn()\n            && actorNotFrozen()\n            && action == 'escrow_release'\n            && request.auth.uid == ownerId\n            && requestDoc.ownerId == ownerId\n            && requestDoc.sitterId == userId\n            && requestDoc.status == 'completed'\n            && requestDoc.escrowStatus == 'released'\n            && request.resource.data.balance == resource.data.balance + requestDoc.creditsOffered;\n        }\n\n        function escrowRefundWalletUpdateAllowed() {\n          let action = request.resource.data.lastWalletAction;\n          let requestId = request.resource.data.lastRequestId;\n          let ownerId = request.resource.data.lastRequestOwnerId;\n          let requestDoc = getAfter(/databases/$(database)/documents/users/$(ownerId)/requests/$(requestId)).data;\n          return signedIn()\n            && actorNotFrozen()\n            && action == 'escrow_refund'\n            && userId == ownerId\n            && (request.auth.uid == ownerId || request.auth.uid == requestDoc.sitterId)\n            && requestDoc.ownerId == ownerId\n            && requestDoc.status == 'cancelled'\n            && requestDoc.escrowStatus == 'refunded'\n            && request.resource.data.balance == resource.data.balance + requestDoc.creditsOffered;\n        }\n\n        allow read, create: if ownerOrAdmin(userId) && actorNotFrozen();\n        allow update: if (ownerOrAdmin(userId) && actorNotFrozen())\n          || escrowReleaseWalletUpdateAllowed()\n          || escrowRefundWalletUpdateAllowed();\n        allow delete: if false;\n\n        match /transactions/{txId} {\n          function escrowReleaseTransactionAllowed() {\n            let walletAfter = getAfter(walletDocPath()).data;\n            let ownerId = walletAfter.lastRequestOwnerId;\n            let requestId = walletAfter.lastRequestId;\n            let requestDoc = getAfter(/databases/$(database)/documents/users/$(ownerId)/requests/$(requestId)).data;\n            return signedIn()\n              && actorNotFrozen()\n              && request.resource.data.type == 'escrow-release'\n              && request.resource.data.requestId == requestId\n              && walletAfter.lastWalletAction == 'escrow_release'\n              && request.auth.uid == ownerId\n              && requestDoc.ownerId == ownerId\n              && requestDoc.sitterId == userId\n              && requestDoc.status == 'completed'\n              && requestDoc.escrowStatus == 'released'\n              && request.resource.data.amount == requestDoc.creditsOffered;\n          }\n\n          function escrowRefundTransactionAllowed() {\n            let walletAfter = getAfter(walletDocPath()).data;\n            let ownerId = walletAfter.lastRequestOwnerId;\n            let requestId = walletAfter.lastRequestId;\n            let requestDoc = getAfter(/databases/$(database)/documents/users/$(ownerId)/requests/$(requestId)).data;\n            return signedIn()\n              && actorNotFrozen()\n              && request.resource.data.type == 'escrow-refund'\n              && request.resource.data.requestId == requestId\n              && walletAfter.lastWalletAction == 'escrow_refund'\n              && userId == ownerId\n              && (request.auth.uid == ownerId || request.auth.uid == requestDoc.sitterId)\n              && requestDoc.ownerId == ownerId\n              && requestDoc.status == 'cancelled'\n              && requestDoc.escrowStatus == 'refunded'\n              && request.resource.data.amount == requestDoc.creditsOffered;\n          }\n\n          allow read: if ownerOrAdmin(userId);\n          allow create: if (ownerOrAdmin(userId) && actorNotFrozen())\n            || escrowReleaseTransactionAllowed()\n            || escrowRefundTransactionAllowed();\n          allow update, delete: if false;\n        }\n      }\n\n      match /requests/{requestId} {\n        function isRequestOwner() {\n          return isSelf(userId);\n        }\n\n        function isAssignedSitter() {\n          return signedIn() && resource.data.sitterId == request.auth.uid;\n        }\n\n        // Sitter apply/withdraw support: only applications + updatedAt can change on open requests.\n        function applicantApplicationUpdateAllowed() {\n          return signedIn()\n            && actorNotFrozen()\n            && !isRequestOwner()\n            && resource.data.status == 'open'\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applications', 'updatedAt']);\n        }\n\n        // Sitter flow support:\n        // accepted -> awaiting_confirmation, or accepted/awaiting_confirmation -> cancelled.\n        function assignedSitterStatusUpdateAllowed() {\n          return signedIn()\n            && actorNotFrozen()\n            && isAssignedSitter()\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'escrowStatus'])\n            && (\n              (resource.data.status == 'accepted'\n                && request.resource.data.status == 'awaiting_confirmation'\n                && request.resource.data.escrowStatus == resource.data.escrowStatus)\n              || (\n                (resource.data.status == 'accepted' || resource.data.status == 'awaiting_confirmation')\n                && request.resource.data.status == 'cancelled'\n                && request.resource.data.escrowStatus == 'refunded'\n              )\n            );\n        }\n\n        allow read: if signedIn() && (\n          resource.data.status == 'open'\n          || isRequestOwner()\n          || isAssignedSitter()\n          || isAdmin()\n        );\n        allow create: if isRequestOwner() && actorNotFrozen();\n        allow update, delete: if (isRequestOwner() && actorNotFrozen())\n          || applicantApplicationUpdateAllowed()\n          || assignedSitterStatusUpdateAllowed()\n          || isAdmin();\n\n        match /conversations/{conversationId} {\n          function participantInConversation(data) {\n            return signedIn()\n              && data.participants is list\n              && request.auth.uid in data.participants;\n          }\n\n          allow read: if isAdmin() || participantInConversation(resource.data);\n          allow create: if signedIn()\n            && actorNotFrozen()\n            && participantInConversation(request.resource.data)\n            && request.resource.data.ownerId == userId\n            && request.resource.data.requestId == requestId;\n          allow update: if signedIn()\n            && actorNotFrozen()\n            && (isAdmin() || participantInConversation(resource.data))\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n              'lastMessage',\n              'lastMessageAt',\n              'updatedAt',\n              'status'\n            ]);\n          allow delete: if isAdmin() || isRequestOwner();\n\n          match /messages/{messageId} {\n            function parentConversation() {\n              return get(\n                /databases/$(database)/documents/users/$(userId)/requests/$(requestId)/conversations/$(conversationId)\n              );\n            }\n\n            function participantInParentConversation() {\n              return signedIn()\n                && parentConversation().data.participants is list\n                && request.auth.uid in parentConversation().data.participants;\n            }\n\n            allow read: if isAdmin() || participantInParentConversation();\n            allow create: if signedIn()\n              && actorNotFrozen()\n              && participantInParentConversation()\n              && request.resource.data.senderId == request.auth.uid\n              && request.resource.data.ownerId == userId\n              && request.resource.data.requestId == requestId\n              && request.resource.data.sitterId == parentConversation().data.sitterId;\n            allow update: if signedIn()\n              && actorNotFrozen()\n              && participantInParentConversation()\n              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);\n            allow delete: if isAdmin();\n          }\n        }\n      }\n    }\n\n    match /favorites/{favoriteId} {\n      allow read: if signedIn()\n        && (\n          resource.data.ownerId == request.auth.uid\n          || resource.data.sitterId == request.auth.uid\n          || isAdmin()\n        );\n      allow create: if signedIn()\n        && actorNotFrozen()\n        && request.resource.data.ownerId == request.auth.uid\n        && request.resource.data.sitterId is string\n        && request.resource.data.sitterId != request.auth.uid;\n      allow delete: if signedIn()\n        && (resource.data.ownerId == request.auth.uid || isAdmin());\n      allow update: if false;\n    }\n\n    match /notifications/{notificationId} {\n      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());\n      allow create: if signedIn() && actorNotFrozen();\n      allow update: if signedIn()\n        && resource.data.userId == request.auth.uid\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);\n      allow delete: if isAdmin();\n    }\n\n    match /reports/{reportId} {\n      allow create: if signedIn() && actorNotFrozen();\n      allow read: if isAdmin() || (signedIn() && resource.data.reporterId == request.auth.uid);\n      allow update, delete: if isAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-03-13T20:49:56.110815Z","metadata":{"services":["cloud.firestore"]}}
